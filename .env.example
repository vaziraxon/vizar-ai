# Copy this file to .env.local and fill in your Supabase project's values.
# See SUPABASE_SETUP.md for step-by-step instructions.
#
# Both of these are safe to expose to the browser (that's what the
# NEXT_PUBLIC_ prefix means) — they are the project URL and the public
# "anon" key, which Supabase's Row Level Security policies protect.
#
# Never add a SUPABASE_SERVICE_ROLE_KEY here or anywhere else this app
# reads from. This project does not use the service-role key at all —
# every operation goes through RLS-scoped queries as the signed-in
# user. If a future feature genuinely needs elevated privileges, it
# must run in a separate, carefully reviewed server-only context — not
# as an env var read by this Next.js app.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Required in production so password-reset emails link back to your
# real domain instead of falling back to http://localhost:3000 (see
# getPublicSiteUrl() in src/lib/actions/auth.ts). Also remember to add
# `${NEXT_PUBLIC_SITE_URL}/auth/callback` to Supabase's Auth > URL
# Configuration redirect allow-list (SUPABASE_SETUP.md, step 10).
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# Comma-separated allowlist of emails allowed to view /admin (see
# src/lib/supabase/authz.ts). There is no admin role in the database —
# this is a server-only env var, never exposed to the browser. Leave
# unset and /admin is unreachable by anyone, including you.
ADMIN_EMAILS=you@example.com

# Optional — enables a real shared (cross-instance) rate limiter for
# login/register/password-reset via Upstash Redis. Without these, auth
# actions fall back to a best-effort in-memory limiter (see
# src/lib/rate-limit.ts). Get free values from https://console.upstash.com
# (create a Redis database, copy the REST URL and token).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI knowledge-base answers (/dashboard/assistant → /api/knowledge/ask).
# Server-only; never prefix with NEXT_PUBLIC_. Without it the assistant
# still shows the matching book passages and sources, but writes no answer.
ANTHROPIC_API_KEY=

# Optional override for the assistant's answer generator (src/lib/ai/mode.ts):
#   unset — live when ANTHROPIC_API_KEY is set; otherwise mock under
#           `next dev` and "book passages only" in production/previews
#   off   — never call the paid AI API, even if a key is set
#   mock  — canned test answers (honoured only under `next dev`)
KB_AI_MODE=
